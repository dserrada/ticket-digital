<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration>
<configuration debug="true">

    <!-- Appender para consola: Escribe en System.out -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Formato del log: Fecha, Nivel, Hilo, Logger, Mensaje, Nueva línea -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Nivel de log a nivel ROOT para tests (DEBUG, INFO, WARN, ERROR) -->
    <!-- Se recomienda DEBUG para tests para tener detalle máximo -->
    <root>
        <level value="DEBUG"/>
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Opcional: Configurar librerías específicas a WARN para no saturar -->
    <!--
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    -->

</configuration>
